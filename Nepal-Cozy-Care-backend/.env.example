# ==========================================
# Nepal Cozy Care - Backend Environment Configuration
# ==========================================
# For local development: copy this to .env and adjust variables
# For Render deployment: set these as Environment Variables in Render Dashboard

APP_NAME="Nepal Cozy Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend-service.onrender.com

# URL of the deployed frontend on Render (used for CORS and cookies; comma-separate multiple origins)
FRONTEND_URL=https://nepal-cozy-care.onrender.com,https://nepal-cozy-care-frontend.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==========================================
# Database Configuration (Render PostgreSQL)
# ==========================================
DB_CONNECTION=pgsql
# On Render, paste the "Internal Database URL" here:
DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a:5432/dbname
# Alternatively, fill individual fields if not using DATABASE_URL:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nepal_cozy_care
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Automatic migration execution on container start (true/false)
RUN_MIGRATIONS=true

# ==========================================
# Session & Cache
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ==========================================
# Filesystem / Uploaded Media Storage
# ==========================================
# Note: Render containers have temporary disks.
# For temporary local storage: FILESYSTEM_DISK=public
# For persistent production storage: FILESYSTEM_DISK=s3 (AWS S3 or Cloudflare R2)
FILESYSTEM_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# Mail Configuration (SMTP / Gmail App Password)
# ==========================================
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# Google Authentication
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

