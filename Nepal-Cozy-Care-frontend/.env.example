# ==========================================
# Nepal Cozy Care - Frontend Environment Configuration
# ==========================================
# For local development: copy this to .env and adjust variables
# For Render Static Site deployment: set these under Environment Variables in Render Dashboard

# URL of your deployed Laravel Backend Web Service on Render (no trailing slash)
VITE_API_BASE_URL=https://your-backend-service.onrender.com

# Request timeout in milliseconds (default: 10000)
VITE_API_TIMEOUT=10000

# Google OAuth Client ID (optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
